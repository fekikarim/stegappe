# ─────────────────────────────────────────────────────────────────────────────
# STEG Mobile App (Flutter) — Configuration Reference
# Flutter uses --dart-define at build/run time; no .env file is committed.
# This file documents all available configuration parameters.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ────────────────────────────────────────────────────────────
# Base URL of the Spring Boot backend.
# Local (Android emulator): http://10.0.2.2:8080
# Local (iOS simulator): http://localhost:8080
# Local (physical device): http://192.168.x.x:8080
# Production: https://api.steg.tn
# Pass to flutter run/build with: --dart-define=API_BASE_URL=<url>
API_BASE_URL=http://10.0.2.2:8080

# ── WebSocket URL (optional) ───────────────────────────────────────────────────
# If omitted, derived from API_BASE_URL by protocol substitution
# (http→ws, https→wss). Only override if API and WebSocket differ.
# Pass with: --dart-define=WS_BASE_URL=<url>
# WS_BASE_URL=

# ── Examples ────────────────────────────────────────────────────────────────────
# Local development (Android emulator):
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8080
#
# Local development (iOS simulator):
#   flutter run --dart-define=API_BASE_URL=http://localhost:8080
#
# Local development (physical device on LAN):
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.100:8080
#
# Production build:
#   flutter build apk --release --dart-define=API_BASE_URL=https://api.steg.tn
#   flutter build ios --release --dart-define=API_BASE_URL=https://api.steg.tn
